root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.json]
indent_size = 2

[{*.ts,*.js}]
indent_size = 2

[*.yml]
indent_size = 2

[*.sh]
end_of_line = lf

# Test methods are not an API: their names read as sentences, so the Async suffix rule does not apply.
[language-server/src/Geowerkstatt.Interlis.LanguageServer.Test/**.cs]
dotnet_diagnostic.VSTHRD200.severity = none
